# =============================================================================
# MigrantsBridge - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=migrantsbridge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=migrantsbridge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://migrantsbridge:changeme@localhost:5432/migrantsbridge

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=MigrantsBridge

# -----------------------------------------------------------------------------
# Anthropic Claude API
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@migrantsbridge.org
SMTP_FROM_NAME=MigrantsBridge

# -----------------------------------------------------------------------------
# Slack (operational alerts, reminders, daily KPI pulse)
# -----------------------------------------------------------------------------
# Bot OAuth token (xoxb-...) from a Slack app with the chat:write scope.
SLACK_BOT_TOKEN=
# Default channel id/name for outbound messages (e.g. #ops-alerts or C0123456789).
SLACK_DEFAULT_CHANNEL=
# Incoming-webhook URL used as a fallback when no bot token is configured.
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Notion (durable single-source-of-truth: cases, KPIs, knowledge base)
# -----------------------------------------------------------------------------
# Internal integration token (secret_...) from a Notion internal integration.
NOTION_API_KEY=
# Database id used to log cases/KPIs (share the database with the integration).
NOTION_CASES_DATABASE_ID=

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# First Admin User (created on initial setup)
# -----------------------------------------------------------------------------
FIRST_ADMIN_EMAIL=admin@migrantsbridge.org
FIRST_ADMIN_PASSWORD=changeme
